<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IT Arcade</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FFFFFF;
    --ink:#14151A;
    --ink-soft:#565A66;
    --ink-faint:#9096A3;
    --line:#ECEDF1;
    --line-2:#DEE0E6;
    --display:"Space Grotesk","Segoe UI",system-ui,sans-serif;
    --sans:"Inter","Segoe UI",system-ui,-apple-system,sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:var(--sans);
    -webkit-font-smoothing:antialiased;
    min-height:100vh;overflow-x:hidden;
  }
  /* drifting color field — keeps page white but alive */
  .blobs{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
  .blobs span{
    position:absolute;width:44vmax;height:44vmax;border-radius:50%;
    filter:blur(90px);opacity:.16;
  }
  .blobs .b1{background:#2AA6C7;top:-16vmax;left:-10vmax;animation:drift1 22s ease-in-out infinite}
  .blobs .b2{background:#F43F7A;top:-10vmax;right:-14vmax;animation:drift2 26s ease-in-out infinite}
  .blobs .b3{background:#16B364;bottom:-18vmax;left:8vmax;animation:drift3 30s ease-in-out infinite}
  .blobs .b4{background:#F59E0B;bottom:-16vmax;right:-8vmax;animation:drift4 24s ease-in-out infinite}
  @keyframes drift1{50%{transform:translate(8vmax,6vmax) scale(1.1)}}
  @keyframes drift2{50%{transform:translate(-6vmax,8vmax) scale(1.15)}}
  @keyframes drift3{50%{transform:translate(6vmax,-6vmax) scale(1.1)}}
  @keyframes drift4{50%{transform:translate(-8vmax,-4vmax) scale(1.12)}}

  #hub{
    position:relative;z-index:1;
    max-width:1060px;margin:0 auto;
    padding:60px 28px 80px;
  }
  /* masthead */
  .masthead{display:flex;flex-direction:column;gap:20px;margin-bottom:44px}
  .titlerow{display:flex;align-items:center;gap:16px}
  .chill{display:flex;align-items:center;gap:13px;flex-wrap:wrap;
    animation:cardin .6s cubic-bezier(.2,.7,.2,1) .15s both}
  .pill{display:inline-flex;align-items:center;gap:8px;
    font-family:var(--display);font-weight:600;font-size:13px;letter-spacing:.01em;color:#fff;
    padding:8px 16px;border-radius:999px;white-space:nowrap;
    background:linear-gradient(100deg,#2AA6C7,#16B364,#F59E0B,#F43F7A,#2AA6C7);
    background-size:260% 100%;animation:sweep 7s linear infinite;
    box-shadow:0 8px 20px -8px rgba(20,21,26,.45)}
  .pill .ic{display:inline-block;animation:wobble 2.2s ease-in-out infinite}
  @keyframes wobble{0%,100%{transform:rotate(0)}20%{transform:rotate(-16deg)}60%{transform:rotate(14deg)}}
  .chilltext{font-size:14.5px;color:var(--ink-soft);font-weight:500;letter-spacing:.005em}
  .coin{
    width:52px;height:52px;border-radius:14px;flex:0 0 auto;
    background:conic-gradient(from 0deg,#2AA6C7,#16B364,#F59E0B,#F43F7A,#2AA6C7);
    display:flex;align-items:center;justify-content:center;font-size:26px;
    box-shadow:0 8px 24px -8px rgba(20,21,26,.4);
    animation:spin 8s linear infinite, bob 3s ease-in-out infinite;
  }
  @keyframes spin{to{transform:rotate(360deg)}}
  @keyframes bob{50%{margin-top:-6px}}
  .coin i{font-style:normal;display:block;animation:spin 8s linear infinite reverse}
  h1{
    font-family:var(--display);font-weight:700;
    font-size:clamp(32px,6.5vw,56px);letter-spacing:-.02em;line-height:.95;
    background:linear-gradient(100deg,#2AA6C7,#16B364,#F59E0B,#F43F7A,#2AA6C7);
    background-size:260% 100%;
    -webkit-background-clip:text;background-clip:text;color:transparent;
    animation:sweep 7s linear infinite;
  }
  @keyframes sweep{to{background-position:260% 0}}

  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(232px,1fr));gap:20px}
  .card{
    position:relative;display:flex;flex-direction:column;
    background:#fff;border:1px solid var(--line);border-radius:18px;
    padding:0 0 20px;cursor:pointer;overflow:hidden;
    opacity:0;transform:translateY(14px);
    animation:cardin .5s cubic-bezier(.2,.7,.2,1) forwards;
    transition:transform .22s cubic-bezier(.2,.7,.2,1), box-shadow .22s ease, border-color .22s ease;
  }
  @keyframes cardin{to{opacity:1;transform:none}}
  .card:hover,.card:focus-visible{
    transform:translateY(-7px);
    border-color:transparent;
    box-shadow:0 22px 46px -18px var(--shadow,rgba(20,21,26,.4)), 0 0 0 1.5px var(--accent,#ddd);
    outline:none;
  }
  /* animated preview */
  .motif{
    position:relative;height:104px;overflow:hidden;
    border-bottom:1px solid var(--line);
    background:var(--tint,#f7f8fa);
  }
  .card:hover .motif{filter:saturate(1.15)}
  .body{padding:18px 22px 0}
  .kicker{display:flex;align-items:center;gap:8px;margin-bottom:9px}
  .kicker .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:pdot 1.6s ease-in-out infinite}
  @keyframes pdot{}
  @keyframes pdot2{}
  @keyframes pulse{0%,100%{box-shadow:0 0 0 0 var(--accent)}50%{box-shadow:0 0 0 4px transparent}}
  .kicker span{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint);font-weight:600}
  .card h3{font-family:var(--display);font-weight:600;font-size:21px;letter-spacing:-.01em;margin-bottom:8px}
  .card .desc{font-size:13px;line-height:1.55;color:var(--ink-soft)}
  .card .play{
    margin-top:16px;display:inline-flex;align-items:center;gap:7px;
    font-family:var(--display);font-size:13px;font-weight:600;color:var(--accent);
  }
  .card .play .arr{transition:transform .2s cubic-bezier(.2,.7,.2,1)}
  .card:hover .play .arr{transform:translateX(5px)}
  .idx{position:absolute;top:12px;right:14px;z-index:3;
    font-family:var(--display);font-weight:700;font-size:12px;color:#fff;
    background:rgba(20,21,26,.28);border-radius:20px;padding:2px 9px;backdrop-filter:blur(3px)}

  /* ===== motif: helpdesk (draining SLA bars) ===== */
  .m-helpdesk .row{position:absolute;left:18px;height:11px;border-radius:6px;
    background:linear-gradient(90deg,var(--accent),var(--accent2));transform-origin:left}
  .m-helpdesk .r1{top:26px;width:76%;animation:sla 2.6s ease-in-out infinite}
  .m-helpdesk .r2{top:46px;width:58%;animation:sla 2.6s ease-in-out .55s infinite}
  .m-helpdesk .r3{top:66px;width:68%;animation:sla 2.6s ease-in-out 1.1s infinite}
  @keyframes sla{0%{transform:scaleX(1)}62%{transform:scaleX(.06)}66%{transform:scaleX(.06);opacity:.5}70%{transform:scaleX(1);opacity:1}100%{transform:scaleX(1)}}

  /* ===== motif: snake ===== */
  .m-snake .seg{position:absolute;top:50%;width:13px;height:13px;margin-top:-6px;border-radius:3px;
    background:var(--accent);animation:snmove 3s linear infinite}
  .m-snake .s0{animation-delay:0s}   .m-snake .s1{animation-delay:.12s;opacity:.85}
  .m-snake .s2{animation-delay:.24s;opacity:.7} .m-snake .s3{animation-delay:.36s;opacity:.55}
  @keyframes snmove{0%{left:-18px}100%{left:calc(100% + 18px)}}
  .m-snake .food{position:absolute;top:50%;left:68%;width:10px;height:10px;margin-top:-5px;border-radius:50%;
    background:var(--accent2);box-shadow:0 0 0 4px color-mix(in srgb,var(--accent2) 25%,transparent);
    animation:snfood 3s linear infinite}
  @keyframes snfood{0%,58%{transform:scale(1);opacity:1}64%{transform:scale(1.7);opacity:0}66%{opacity:0}100%{opacity:1}}

  /* ===== motif: slicer ===== */
  .m-slicer .threat{position:absolute;font-size:22px;animation:slpop 2.2s ease-in-out infinite}
  .m-slicer .a{left:24%;top:20%} .m-slicer .b{left:58%;top:44%;animation-delay:.12s}
  @keyframes slpop{0%,44%{transform:scale(1) rotate(0);opacity:1}54%{transform:scale(1.4) rotate(22deg);opacity:0}56%{transform:scale(0);opacity:0}82%{opacity:0}100%{transform:scale(1);opacity:1}}
  .m-slicer .blade{position:absolute;left:-30%;width:160%;height:3px;
    background:linear-gradient(90deg,transparent,var(--accent),transparent);
    box-shadow:0 0 12px var(--accent);animation:slash 2.2s ease-in-out infinite}
  @keyframes slash{0%{top:120%;opacity:0}34%{opacity:1}52%{top:-20%;opacity:1}64%{opacity:0}100%{top:-20%;opacity:0}}

  /* ===== motif: stack ===== */
  .m-stack .blk{position:absolute;left:50%;height:15px;border-radius:3px;
    background:linear-gradient(var(--accent2),var(--accent))}
  .m-stack .base{bottom:16px;width:46px;margin-left:-23px}
  .m-stack .mid{bottom:31px;width:42px;margin-left:-21px;animation:stmid 2.8s ease-in-out infinite}
  .m-stack .top{bottom:46px;width:38px;margin-left:-19px;animation:sttop 2.8s ease-in-out infinite}
  @keyframes stmid{0%{transform:translateY(-64px);opacity:0}18%{opacity:1}30%{transform:translateY(0)}100%{transform:translateY(0);opacity:1}}
  @keyframes sttop{0%,34%{transform:translateY(-64px);opacity:0}42%{opacity:1}56%{transform:translateY(0)}62%{transform:translateY(-4px)}70%{transform:translateY(0)}100%{transform:translateY(0);opacity:1}}

  /* ===== player ===== */
  #player{position:fixed;inset:0;z-index:60;display:none;flex-direction:column;background:#fff}
  #player.open{display:flex;animation:cardin .28s ease}
  .topbar{display:flex;align-items:center;gap:16px;flex:0 0 auto;padding:13px 20px;
    background:#fff;border-bottom:1px solid var(--line)}
  .back{display:inline-flex;align-items:center;gap:8px;cursor:pointer;
    background:#fff;border:1px solid var(--line-2);color:var(--ink);
    font-family:var(--display);font-weight:600;font-size:13px;padding:9px 16px;border-radius:10px;
    transition:background .16s,border-color .16s,transform .1s}
  .back:hover{background:#FAFAFB;border-color:var(--ink-faint)}
  .back:active{transform:scale(.97)}
  .nowplaying{display:flex;align-items:center;gap:12px}
  .nowplaying .dim{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-faint);font-weight:600}
  .nowplaying .t{font-family:var(--display);font-weight:600;font-size:17px}
  #frameWrap{flex:1;position:relative;overflow:hidden;background:#060912}
  iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    color:var(--ink-faint);font-family:var(--display);font-size:12px;letter-spacing:.24em;text-transform:uppercase;
    z-index:2;background:#fff}
  .loading.hide{display:none}
  .loading b{animation:bob 1s ease-in-out infinite;font-weight:600}

  @media (prefers-reduced-motion:reduce){*{animation-duration:.001s !important;animation-iteration-count:1 !important}}
  @media (max-width:520px){
    #hub{padding:40px 16px 50px}.masthead{margin-bottom:30px;gap:16px}
    .chilltext{font-size:13px}
    .topbar{padding:11px 13px}.nowplaying .dim{display:none}
  }
</style>
</head>
<body>
  <div class="blobs"><span class="b1"></span><span class="b2"></span><span class="b3"></span><span class="b4"></span></div>

  <main id="hub">
    <header class="masthead">
      <div class="titlerow">
        <div class="coin"><i>🕹️</i></div>
        <h1>IT&nbsp;Arcade</h1>
      </div>
      <div class="chill">
        <span class="pill"><span class="ic">💊</span>Breakout&nbsp;Zone</span>
        <span class="chilltext">Take a chill pill&nbsp;— then resume work.</span>
      </div>
    </header>
    <div class="grid" id="grid"></div>
  </main>

  <section id="player" aria-hidden="true">
    <div class="topbar">
      <button class="back" id="backBtn">← &nbsp;Arcade</button>
      <div class="nowplaying"><span class="dim">Now Playing</span><span class="t" id="npTitle"></span></div>
    </div>
    <div id="frameWrap">
      <div class="loading" id="loading"><b>Loading</b></div>
      <iframe id="gameFrame" title="game" allow="autoplay; fullscreen"></iframe>
    </div>
  </section>

<script>
var GAMES = [{"key":"helpdesk","sub":"Service Desk Rush","title":"Helpdesk Hero","desc":"Users flood the queue with laptop issues. Tap a ticket, apply the right fix before the SLA blows.","color":"#2AA6C7","color2":"#3B82F6","tint":"#EAF6FA","glow":"rgba(42,166,199,.45)","data":""},{"key":"snake","sub":"Packet Hunter","title":"Snake.exe","desc":"The Nokia 3310 classic, IT edition. Grow your data cable on packets and bug bounties. Dodge the firewall.","color":"#16B364","color2":"#4ADE80","tint":"#E9F8EF","glow":"rgba(22,179,100,.45)","data":""},{"key":"slicer","sub":"Zero Day","title":"Malware Slicer","desc":"Fruit-Ninja for the SOC. Swipe to slice viruses, phishing and ransomware — never the prod backups.","color":"#F43F7A","color2":"#FB7185","tint":"#FDECF2","glow":"rgba(244,63,122,.45)","data":""},{"key":"stack","sub":"Data Center Builder","title":"Stack Overflow","desc":"One-button timing game. Drop server racks to build the tallest data center. Perfect stacks earn bonus KPI.","color":"#F59E0B","color2":"#FBBF24","tint":"#FDF3E3","glow":"rgba(245,158,11,.45)","data":""}];
var grid=document.getElementById("grid");
var player=document.getElementById("player");
var frame=document.getElementById("gameFrame");
var npTitle=document.getElementById("npTitle");
var loading=document.getElementById("loading");

function b64ToStr(b64){
  var bin=atob(b64), bytes=new Uint8Array(bin.length);
  for(var i=0;i<bin.length;i++) bytes[i]=bin.charCodeAt(i);
  return new TextDecoder("utf-8").decode(bytes);
}
function motifHTML(key){
  if(key==="helpdesk") return '<b class="row r1"></b><b class="row r2"></b><b class="row r3"></b>';
  if(key==="snake") return '<i class="seg s0"></i><i class="seg s1"></i><i class="seg s2"></i><i class="seg s3"></i><i class="food"></i>';
  if(key==="slicer") return '<span class="threat a">🦠</span><span class="threat b">🐛</span><span class="blade"></span>';
  if(key==="stack") return '<span class="blk base"></span><span class="blk mid"></span><span class="blk top"></span>';
  return "";
}
GAMES.forEach(function(g,i){
  var card=document.createElement("div");
  card.className="card m-"+g.key;
  card.tabIndex=0; card.setAttribute("role","button");
  card.style.setProperty("--accent",g.color);
  card.style.setProperty("--accent2",g.color2);
  card.style.setProperty("--tint",g.tint);
  card.style.setProperty("--shadow",g.glow);
  card.style.animationDelay=(0.06*i)+"s";
  var num=("0"+(i+1)).slice(-2);
  card.innerHTML=
    '<span class="idx">'+num+'</span>'+
    '<div class="motif">'+motifHTML(g.key)+'</div>'+
    '<div class="body">'+
      '<div class="kicker"><span class="dot"></span><span>'+g.sub+'</span></div>'+
      '<h3>'+g.title+'</h3>'+
      '<div class="desc">'+g.desc+'</div>'+
      '<div class="play">Play<span class="arr">&rarr;</span></div>'+
    '</div>';
  function launch(){ openGame(g); }
  card.addEventListener("click",launch);
  card.addEventListener("keydown",function(e){ if(e.key==="Enter"||e.key===" "){ e.preventDefault(); launch(); }});
  grid.appendChild(card);
});
function openGame(g){
  npTitle.textContent=g.title;
  loading.classList.remove("hide");
  player.classList.add("open"); player.setAttribute("aria-hidden","false");
  document.body.style.overflow="hidden";
  frame.onload=function(){ loading.classList.add("hide"); };
  frame.srcdoc=b64ToStr(g.data);
}
function closeGame(){
  player.classList.remove("open"); player.setAttribute("aria-hidden","true");
  document.body.style.overflow=""; frame.srcdoc=""; loading.classList.remove("hide");
}
document.getElementById("backBtn").addEventListener("click",closeGame);
window.addEventListener("keydown",function(e){ if(e.key==="Escape"&&player.classList.contains("open")) closeGame(); });
</script>
</body>
</html>
